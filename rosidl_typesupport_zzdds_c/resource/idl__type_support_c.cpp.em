#include "rosidl_typesupport_zzdds_c/message_type_support.hpp"
#include "rosidl_typesupport_zzdds_cpp/message_type_support.hpp"

@[for header in nested_headers(messages)]@
#include "@(header.replace('__rosidl_typesupport_zzdds_cpp.hpp', '__functions.h'))"
#include "@(header.replace('__rosidl_typesupport_zzdds_cpp.hpp', '__rosidl_typesupport_zzdds_c.h'))"
@[end for]@

@[for message in messages]@
@{
type_ = message.structure.namespaced_type
ctype = '__'.join(type_.namespaced_name())
namespaces = list(type_.namespaces)
symbol = c_symbol(type_)
keyed = has_key(message)
message_stem = convert_camel_case_to_lower_case_underscore(type_.name)
