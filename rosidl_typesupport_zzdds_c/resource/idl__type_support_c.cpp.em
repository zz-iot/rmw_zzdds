static const rosidl_typesupport_zzdds_cpp::message_type_support_callbacks_t
callbacks_@(message_stem) = {
  "@('::'.join(namespaces))", "@(type_.name)", "@(dds_type_name(type_))",
  serialize_@(message_stem), deserialize_@(message_stem),
  create_ros_message_@(message_stem), destroy_ros_message_@(message_stem),
