find_package(ament_cmake_core QUIET REQUIRED)
find_package(rosidl_generator_c REQUIRED)
ament_register_extension(
  "rosidl_generate_idl_interfaces"
  "rosidl_typesupport_zzdds_c"
  "rosidl_typesupport_zzdds_c_generate_interfaces.cmake")
set(rosidl_typesupport_zzdds_c_LIBRARY_TYPE "@rosidl_typesupport_zzdds_c_LIBRARY_TYPE@")
set(rosidl_typesupport_zzdds_c_BIN
  "${rosidl_typesupport_zzdds_c_DIR}/../../../lib/rosidl_typesupport_zzdds_c/rosidl_typesupport_zzdds_c")
normalize_path(rosidl_typesupport_zzdds_c_BIN "${rosidl_typesupport_zzdds_c_BIN}")
set(rosidl_typesupport_zzdds_c_TEMPLATE_DIR
  "${rosidl_typesupport_zzdds_c_DIR}/../resource")
normalize_path(rosidl_typesupport_zzdds_c_TEMPLATE_DIR
  "${rosidl_typesupport_zzdds_c_TEMPLATE_DIR}")
